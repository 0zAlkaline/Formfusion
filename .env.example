# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_ID: Server-side Gemini model identifier for Vision Object Identification.
# Defaults to gemini-4-hydrogen when unset; must be a valid non-empty Gemini model ID.
GEMINI_MODEL_ID="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OVH_AI_ENDPOINTS_ACCESS_TOKEN: Optional server-side OVHcloud AI Endpoints access token
# for higher-rate authenticated free-tier Stable Diffusion XL access (400 RPM).
# Keep strictly server-side; never prefix with VITE_.
OVH_AI_ENDPOINTS_ACCESS_TOKEN="MY_OVH_AI_ENDPOINTS_ACCESS_TOKEN"

# OVH_AI_ENDPOINTS_ALLOW_ANONYMOUS: Optional explicit opt-in ("true") for anonymous
# free-tier SDXL development testing (limited to 2 RPM per IP/model) when no token is set.
OVH_AI_ENDPOINTS_ALLOW_ANONYMOUS="false"

